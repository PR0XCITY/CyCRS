{
  "id": "attack-likelihood",
  "title": "Which attacks a business is most exposed to",
  "module": "4: Logistic regression and ROC",
  "stage": "likelihood",
  "used_live": true,
  "order": 9,
  "question": "Given a business's sector, size and the kinds of IT assets it relies on, which attack categories are most likely if it has an incident?",
  "data_in": {
    "dataset": "VCDB incidents with at least one known action category",
    "n_rows": 10360,
    "variables": [
      {
        "name": "action_<category>",
        "type": "binary",
        "scale": "nominal",
        "transform": "one target per model"
      },
      {
        "name": "sector",
        "type": "categorical",
        "scale": "nominal",
        "transform": "dummies, reference Other"
      },
      {
        "name": "size",
        "type": "categorical",
        "scale": "ordinal",
        "transform": "dummies, reference small"
      },
      {
        "name": "asset_*",
        "type": "binary",
        "scale": "nominal",
        "transform": "proxy for what the business runs"
      }
    ],
    "prep_steps": [
      "Dropped incidents with no known action category",
      "One stratified 70/30 split shared by all categories (7252 train, 3108 test); test incident ids saved for Phase 6",
      "Environmental attacks left out (too rare for a model)",
      "asset_person left out of the inputs: VERIS codes the targeted person as an asset in every social attack, so it restates the label",
      "Fixed feature order of 15 profile features saved with the coefficients"
    ],
    "sample_rows": [
      {
        "sector": "Health Care and Social Assistance",
        "size": "large",
        "asset_server": 0,
        "asset_media": 0,
        "action_hacking": 1,
