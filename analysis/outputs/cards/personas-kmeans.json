  "why": "Personas are built only from what a business can tell CyCRS about itself (sector, size, the IT it relies on), so a new user can be placed in one instantly by finding the nearest centroid in the browser. K-means suits this because assignment is a simple distance to 8 saved centres, and the silhouette peaks at k = 8 (0.29).",
  "data_properties": [
    {
      "name": "Chosen k",
      "value": 8,
      "implication": "Number of personas."
    },
    {
      "name": "Best mean silhouette",
      "value": 0.29153792,
      "implication": "Separation of personas; above 0.5 is strong, below 0.25 weak."
    },
    {
      "name": "Largest persona",
      "value": "Mixed sector, small, server (2003 incidents)",
      "implication": "Its leading attack is hacking."
    }
  ],
  "alternatives": [
    {
      "model": "Hierarchical clustering",
      "why_not": "Cannot place a new business without refitting the tree; K-means needs only the saved centroids."
    },
    {
      "model": "DBSCAN",
      "why_not": "Not in the syllabus, and on 0/1 profile data the density of points varies hugely between common and rare profiles."
    }
  ],
  "formula_tex": [
    {
      "label": "K-means objective",
      "tex": "\\min \\sum_{i}\\lVert x_i-\\mu_{c(i)}\\rVert^2"
    },
    {
      "label": "Silhouette",
      "tex": "s_i=\\frac{b_i-a_i}{\\max(a_i,b_i)}"
    },
    {
      "label": "Assignment",
      "tex": "c(x)=\\arg\\min_k \\lVert x-\\mu_k\\rVert^2"
    }
  ],
  "assumptions": [
    {
      "check": "Silhouette at chosen k",
      "statistic": 0.29153792,
      "p_value": null,
      "verdict": "moderate",
      "action_taken": "Personas shown with their actual attack mix, not as hard categories."
    }
  ],
