  "why": "Records lost has skewness 50.6 and a lognormal curve fits it far better than a normal one (KS D 0.091 vs 0.486), so the target is log10(1 + records). On that scale effects are multiplicative and OLS gives coefficients a business owner can read as 'this attack multiplies expected records lost by 10 to the power b'. Breusch-Pagan p is 8.6e-48, so HC3 robust standard errors are used.",
  "data_properties": [
    {
      "name": "Skewness of records lost",
      "value": 50.56625329,
      "implication": "Log transform needed."
    },
    {
      "name": "Breusch-Pagan p",
      "value": 0.0,
      "implication": "Robust errors."
    },
    {
      "name": "Jarque-Bera p",
      "value": 0.0,
      "implication": "Residuals not exactly normal; large n protects inference."
    },
    {
      "name": "Durbin-Watson",
      "value": 1.98407478,
      "implication": "Residual independence check."
    },
    {
      "name": "Maximum VIF",
      "value": 9.39961472,
      "implication": "Predictors are not redundant."
    },
    {
      "name": "Test RMSE gap, business vs best model",
      "value": 0.0924527,
      "implication": "Accuracy given up to use only pre-attack inputs."
    }
  ],
  "alternatives": [
    {
      "model": "Simple linear regression on size",
      "why_not": "One predictor explains only 11.7% and misses sector and attack effects."
    },
    {
      "model": "Full model",
      "why_not": "Test RMSE 1.564 vs 1.657, but it needs actor, asset and discovery details known only after an attack."
    },
    {
      "model": "Backward elimination model",
      "why_not": "Keeps 15 predictors including post-attack ones; same problem as the full model."
    }
  ],
  "formula_tex": [
    {
      "label": "Model",
      "tex": "\\log_{10}(1+\\text{records}) = \\beta_0 + \\sum_j \\beta_j x_j + \\varepsilon"
    },
    {
      "label": "Back-transformed effect",
      "tex": "\\text{multiplier}_j = 10^{\\beta_j}"
    },
    {
      "label": "Expected records",
      "tex": "\\widehat{\\text{records}} = 10^{\\hat y} - 1"
    },
    {
      "label": "Expected cost",
      "tex": "\\widehat{\\text{cost}} = \\widehat{\\text{records}} \\times \\text{cost per record (INR)}"
    }
  ],
  "assumptions": [
    {
      "check": "Linearity and constant variance: Breusch-Pagan",
      "statistic": 299.62830861,
      "p_value": 0.0,
      "verdict": "heteroscedastic",
      "action_taken": "HC3 robust standard errors used for all models."
    },
    {
      "check": "Normal residuals: Jarque-Bera",
      "statistic": 138.3804564,
      "p_value": 0.0,
      "verdict": "not normal",
      "action_taken": "With 3778 training rows the coefficients are still approximately normal (central limit theorem); intervals read with caution."
    },
    {
      "check": "Independent residuals: Durbin-Watson",
      "statistic": 1.98407478,
      "p_value": null,
      "verdict": "no autocorrelation",
      "action_taken": "None needed."
    },
    {
      "check": "Multicollinearity: maximum VIF",
      "statistic": 9.39961472,
      "p_value": null,
      "verdict": "acceptable",
      "action_taken": "No variable above 10; none dropped."
    }
  ],
