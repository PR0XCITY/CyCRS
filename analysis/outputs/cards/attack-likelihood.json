        "action_error": 0
      }
    ]
  },
  "why": "Each target is a binary flag and the inputs are a handful of 0/1 profile features, so logistic regression gives a calibrated probability per category and an odds ratio per feature that a business owner can read. Its formula is a weighted sum and a sigmoid, so the browser reproduces the exact same number from the saved coefficients with no server. Unweighted fits keep probabilities calibrated to the observed category shares (for example 17% for physical).",
  "data_properties": [
    {
      "name": "Best category AUC (physical)",
      "value": 0.89216971,
      "implication": "Profile predicts this attack type well."
    },
    {
      "name": "Weakest category AUC (misuse)",
      "value": 0.68986135,
      "implication": "Profile says little about this attack type; show with caution."
    },
    {
      "name": "Profile features",
      "value": 15,
      "implication": "Small, fixed input set entered by the user."
    }
  ],
  "alternatives": [
    {
      "model": "Decision tree",
      "why_not": "Its probabilities are leaf shares that jump between profiles, and the breach tree needed depth 10; logistic odds ratios are smoother and easier to explain."
    },
    {
      "model": "Naive Bayes",
      "why_not": "Assumes sector, size and asset flags are independent given the attack, but sector and asset use are related, so its probabilities are poorly calibrated."
    },
    {
      "model": "Best breach classifier (decision_tree)",
      "why_not": "Built for a different target; logistic keeps exact browser reproduction and readable coefficients."
    }
  ],
  "formula_tex": [
    {
      "label": "Probability of category c",
      "tex": "P(c \\mid x)=\\frac{1}{1+e^{-(\\beta_{0c}+\\beta_c^\\top x)}}"
    },
    {
      "label": "Odds ratio",
      "tex": "\\mathrm{OR}_j = e^{\\beta_j}"
    }
  ],
