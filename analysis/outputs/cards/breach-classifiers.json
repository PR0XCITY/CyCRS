  "why": "The target is binary and only 1.1% of training incidents are No, so models are compared on AUC and recall/specificity rather than accuracy, and class weights are used where supported. Each model has a data-based reason: logistic, binary target with 22 binary predictors; class weights offset the 61 No cases in training; decision_tree, finds interactions between attack and asset flags as readable rules; depth 10 and leaf 50 chosen by CV AUC; knn, non-parametric baseline on scaled flags; k = 2 minimised CV balanced error; naive_bayes, all predictors are 0/1 flags, so Bernoulli Naive Bayes is the matching likelihood; lda, linear boundary with shared covariance; a classical comparison for logistic regression.",
  "data_properties": [
    {
      "name": "Share of No in training",
      "value": 0.01149859,
      "implication": "Severe imbalance: accuracy is misleading."
    },
    {
      "name": "No cases in test set",
      "value": 26,
      "implication": "Test AUC and specificity are estimated from very few cases."
    },
    {
      "name": "Best model by CV AUC",
      "value": "decision_tree (0.766 +/- 0.039)",
      "implication": "Model used for the Youden threshold."
    },
    {
      "name": "Youden threshold for best model",
      "value": 0.55217763,
      "implication": "J = 0.498; balances recall and specificity."
    }
  ],
  "alternatives": [
    {
      "model": "Accuracy as the selection metric",
      "why_not": "Predicting Yes for every incident already scores 0.989 accuracy."
    },
    {
      "model": "SMOTE oversampling",
      "why_not": "Synthesising 61 rare cases of binary flags creates unrealistic incidents; class weights are simpler and in the syllabus."
    }
  ],
  "formula_tex": [
    {
      "label": "Logistic model",
      "tex": "P(y=1)=\\frac{1}{1+e^{-(\\beta_0+\\beta^\\top x)}}"
    },
    {
      "label": "Bernoulli Naive Bayes",
      "tex": "P(y\\mid x)\\propto P(y)\\prod_j p_{jy}^{x_j}(1-p_{jy})^{1-x_j}"
    },
    {
      "label": "Youden's J",
      "tex": "J=\\text{sensitivity}+\\text{specificity}-1"
    }
  ],
  "assumptions": [
    {
      "check": "Class balance (No share in training)",
      "statistic": 0.01149859,
