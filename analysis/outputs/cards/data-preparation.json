  "why": "Records lost is extremely right skewed (skewness 50.6): the mean is 22,774,208 while the median is 1,364, so a few mega breaches dominate any raw average. After log10(1 + x) the skewness falls to 0.36, which makes regression and distance based methods usable. Dropping every row with any gap would remove 98% of incidents, so Unknown is kept as a category and only each model's own inputs must be present.",
  "data_properties": [
    {
      "name": "Skewness of records lost (raw)",
      "value": 50.5663,
      "implication": "A few huge breaches dominate; raw averages and linear fits would be misleading."
    },
    {
      "name": "Skewness of log10(1 + records lost)",
      "value": 0.3601,
      "implication": "Close to symmetric, so the log scale is used for every model of breach size."
    },
    {
      "name": "IQR outliers in records lost, raw then log",
      "value": "1144 then 9",
      "implication": "The log scale turns most extreme values into ordinary ones, so none are deleted."
    },
    {
      "name": "Share of breach target that is Yes",
      "value": "98.85% (7492 Yes, 87 No)",
      "implication": "Very unbalanced classes: accuracy is meaningless, use ROC AUC and class weights."
    },
    {
      "name": "Rows with at least one missing or Unknown field",
      "value": "97.5%",
      "implication": "Listwise deletion would throw away most of the data."
    }
  ],
  "alternatives": [
    {
      "model": "Mean imputation of records lost",
      "why_not": "The mean (22,774,208) is far above the median (1,364) because of skewness 50.6, so filling gaps with it would invent huge breaches."
    },
    {
      "model": "Listwise deletion across all fields",
      "why_not": "It would drop 10334 of 10596 incidents (98%), mostly because Unknown is common."
    },
    {
      "model": "Treating Potentially as Yes for the target",
      "why_not": "2109 incidents say only Potentially; counting them as breaches would mix confirmed and suspected losses."
    }
  ],
  "formula_tex": [
    {
      "label": "Log transform",
      "tex": "y = \\log_{10}(1 + x)"
    },
    {
      "label": "Sample skewness",
      "tex": "g_1 = \\frac{\\frac{1}{n}\\sum_{i=1}^{n}(x_i-\\bar{x})^3}{\\left(\\frac{1}{n}\\sum_{i=1}^{n}(x_i-\\bar{x})^2\\right)^{3/2}}"
    },
    {
      "label": "IQR outlier fences",
      "tex": "x < Q_1 - 1.5\\,\\mathrm{IQR} \\;\\text{or}\\; x > Q_3 + 1.5\\,\\mathrm{IQR}"
    }
  ],
  "assumptions": [
    {
      "check": "Normality of log10(1 + records lost), D'Agostino K squared",
      "statistic": 214.3835,
      "p_value": 0.0,
      "verdict": "not normal",
      "action_taken": "Keep log scale for symmetry; later models use tests robust to non-normality where needed."
    }
  ],
