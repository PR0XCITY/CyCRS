{
  "id": "mlr-impact",
  "title": "How big a breach could be",
  "module": "3: Multiple linear regression",
  "stage": "impact",
  "used_live": true,
  "order": 7,
  "question": "Given a business's sector, size and the type of attack, how many records would a breach be expected to expose?",
  "data_in": {
    "dataset": "VCDB incidents with known records lost",
    "n_rows": 5398,
    "variables": [
      {
        "name": "data_total",
        "type": "numeric",
        "scale": "ratio",
        "transform": "log10(1 + x) target"
      },
      {
        "name": "action_*",
        "type": "binary",
        "scale": "nominal",
        "transform": "none"
      },
      {
        "name": "actor_*",
        "type": "binary",
        "scale": "nominal",
        "transform": "none"
      },
      {
        "name": "asset_*",
        "type": "binary",
        "scale": "nominal",
        "transform": "none"
      },
      {
        "name": "sector",
        "type": "categorical",
        "scale": "nominal",
        "transform": "dummies for top 8, reference Other"
      },
      {
        "name": "size",
        "type": "categorical",
        "scale": "ordinal",
        "transform": "dummies, reference small"
      },
      {
        "name": "discovery_days",
        "type": "numeric",
        "scale": "ratio",
        "transform": "log10(1 + x), 0 with a known-flag when missing"
      }
    ],
    "prep_steps": [
      "Stratified 70/30 split on target quintiles (random_state 42): 3778 train, 1620 test",
      "Dropped action_environmental action columns with no positive cases",
      "Discovery time missing for most rows, so the full model uses log days set to 0 plus a disc_known flag",
      "VIF checked and Breusch-Pagan decided robust errors"
    ],
