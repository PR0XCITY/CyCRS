{
  "id": "breach-classifiers",
  "title": "Which incidents end in data loss",
  "module": "4: Classification (logistic regression, decision tree, KNN, Naive Bayes, LDA, ROC, confusion matrix)",
  "stage": "likelihood",
  "used_live": false,
  "order": 8,
  "question": "Can the kind of attack, attacker and assets involved tell us whether an incident ends in confirmed data disclosure?",
  "data_in": {
    "dataset": "VCDB incidents with data_disclosure Yes or No",
    "n_rows": 7579,
    "variables": [
      {
        "name": "breach",
        "type": "binary",
        "scale": "nominal",
        "transform": "target, 1 = Yes"
      },
      {
        "name": "actor_*, action_*, asset_*",
        "type": "binary",
        "scale": "nominal",
        "transform": "none"
      },
      {
        "name": "sector",
        "type": "categorical",
        "scale": "nominal",
        "transform": "dummies, reference Other"
      },
      {
        "name": "size",
        "type": "categorical",
        "scale": "ordinal",
        "transform": "dummies, reference small"
      }
    ],
    "prep_steps": [
      "Stratified 70/30 split (random_state 42): train 5244 Yes / 61 No, test 2248 Yes / 26 No",
      "Dropped flags that, in the training rows, occur in only one class or fewer than 5 times: action_environmental, asset_network, sector_manufacturing",
      "Standard scaling inside the pipeline for logistic, KNN and LDA; class_weight balanced for logistic and tree",
      "asset_person left out: VERIS codes the targeted person as an asset in every social attack, so it restates the label"
    ],
