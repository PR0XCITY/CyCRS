      }
    ]
  },
  "why": "Both variables are on log scales, where breach size is close to symmetric (skewness 0.36), so a straight line is a fair first model. A single predictor shows how much size alone explains before adding attack details; here R2 is 0.117.",
  "data_properties": [
    {
      "name": "Slope (log records per log employee)",
      "value": -0.52803525,
      "implication": "Ten times more staff multiplies expected records lost by 0.30."
    },
    {
      "name": "R2",
      "value": 0.11715266,
      "implication": "Share of variation in breach size explained by size alone."
    },
    {
      "name": "Slope p-value",
      "value": 0.0,
      "implication": "Whether the size effect is distinguishable from zero."
    }
  ],
  "alternatives": [
    {
      "model": "Raw records on raw employee count",
      "why_not": "Records lost has skewness 50.6; a raw-scale line would be dominated by a few mega breaches."
    },
    {
      "model": "Multiple regression",
      "why_not": "Used next; this single-predictor model is the baseline it must improve on."
    }
  ],
  "formula_tex": [
    {
      "label": "Fitted line",
      "tex": "\\hat y = 4.906 + -0.528\\,\\log_{10}(\\text{employees})"
    }
  ],
  "assumptions": [
    {
      "check": "Slope t-test",
      "statistic": -22.13121693,
      "p_value": 0.0,
      "verdict": "significant",
      "action_taken": "Size kept as a predictor in the multiple model."
    }
  ],
